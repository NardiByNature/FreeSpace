{
  "name": "tidepool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An evolving ecosystem you can watch. Rust simulation core compiled to WebAssembly, TypeScript renderer.",
  "license": "MIT",
  "scripts": {
    "build:wasm": "wasm-pack build core --target web --out-dir ../pkg --out-name tidepool_core --release",
    "dev": "npm run build:wasm && vite",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "cargo test --workspace",
    "preview": "vite preview"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "rolldown": "1.2.14",
    "postcss": "8.5.30"
  }
}
